# Backend API base URL for the "Reserve early access" form.
# Defaults to https://app.brainbox.sh when unset. Point at a local backend
# during development:
VITE_API_BASE_URL=http://localhost:8787

# Demo widget config (the landing page runs the real Brainbox widget). These
# override the built-in demo defaults for testing against a seeded backend.
# VITE_DEMO_PROJECT_KEY=pk_test_local
# VITE_DEMO_ENDPOINT=http://localhost:8787/ingest
