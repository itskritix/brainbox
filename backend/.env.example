# Auth.js - generate with: openssl rand -base64 33
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → Credentials → OAuth client ID, Web app)
GOOGLE_ID=
GOOGLE_SECRET=
# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://brainbox:brainbox@localhost:5432/brainbox
# Base URL of the Auth.js mount (used for OAuth callbacks)
AUTH_URL=http://localhost:8787/api/auth
# Dashboard origin allowed by CORS (the SPA, step 5)
DASHBOARD_ORIGIN=http://localhost:5173
# Port the API listens on
PORT=8787
# Public base URL of this API (used to build local file URLs)
PUBLIC_API_URL=http://localhost:8787
# Object storage: "local" (writes backend/.storage/) or "r2"
STORAGE_DRIVER=local
# Cloudflare R2 (only needed when STORAGE_DRIVER=r2)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
