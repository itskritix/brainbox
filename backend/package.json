{
  "name": "@brainbox/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@auth/core": "0.41.2",
    "@auth/drizzle-adapter": "^1.11.2",
    "@brainbox/shared": "workspace:*",
    "@hono/auth-js": "^1.1.1",
    "@hono/node-server": "^2.0.6",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "catalog:",
    "typescript-eslint": "^8.60.1"
  }
}
